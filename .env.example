# Copie para .env e ajuste. Local: Postgres via `docker compose up -d postgres`.
# Produção (VPS): deploy/env.vps.example → /docker/medica-certo/.env (não commitar).

NODE_ENV=development
PORT=8080
WEB_PORT=5173
HOST=0.0.0.0
PUBLIC_HOST=medica-certo.altamir.dev

POSTGRES_PASSWORD=medica
POSTGRES_PORT=5432
DATABASE_URL=postgres://medica:medica@127.0.0.1:5432/medica_certo

# Auth (PR2)
SESSION_DAYS=30
# Em localhost deixe 0/omitido. Em produção (HTTPS) use 1.
COOKIE_SECURE=0
# Opcional: cria o primeiro cuidador no boot se a tabela estiver vazia.
# BOOTSTRAP_EMAIL=cuidador@example.com
# BOOTSTRAP_PASSWORD=troque-esta-senha
# BOOTSTRAP_NAME=Cuidador

# Web Push / alarmes (PR8–PR9)
# Gere com: npx --yes web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@altamir.dev
# ALARM_SCHEDULER_MS=45000

# Leitura de caixa/receita por IA (OpenRouter). Sem AI_API_KEY a feature fica desligada.
# AI_ENABLED=1
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL=deepseek/deepseek-v4.1-flash-1017
# AI_PROVIDER_NAME=OpenRouter
# AI_TIMEOUT_MS=45000
# AI_MAX_UPLOAD_BYTES=8388608
# AI_MONTHLY_LIMIT=5
# AI_PRICE_INPUT_PER_MILLION=0.0141
# AI_PRICE_OUTPUT_PER_MILLION=0.144
# AI_HTTP_REFERER=https://medica-certo.altamir.dev
# AI_APP_TITLE=Medica Certo
# AI_DATA_COLLECTION=deny
# Dias em que a imagem da receita ou da foto fica guardada. O scheduler apaga depois.
# AI_IMAGE_RETAIN_DAYS=90
# AI_PROMPT_VERSION=v2

# App container (profile full)
APP_PORT=8080
