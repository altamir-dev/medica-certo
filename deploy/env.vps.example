# Copie para /docker/medica-certo/.env na VPS e preencha.
#   chmod 600 /docker/medica-certo/.env
# Nunca commite o arquivo preenchido. O workflow não envia este arquivo.
#
# O Compose injeta DATABASE_URL para o serviço `postgres`
# (usuário medica, banco medica_certo, porta interna 5432).
# Um DATABASE_URL aqui é ignorado pelo container.
#
# POSTGRES_PASSWORD entra na URL. Use só letras, dígitos e ._-
# (sem espaço, $, @, :, /, #, ?, %).

POSTGRES_PASSWORD=troque-esta-senha

# Nome da rede Docker externa em que o Traefik já está.
#   docker network ls
#   docker inspect <container-do-traefik> --format '{{range $k, $v := .NetworkSettings.Networks}}{{println $k}}{{end}}'
TRAEFIK_NETWORK=nome-da-rede-traefik

# Opcionais. O padrão é o mesmo do compose local.
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt

PUBLIC_HOST=medica-certo.altamir.dev

# O Compose força NODE_ENV=production, PORT=8080, HOST=0.0.0.0 e COOKIE_SECURE=1.
SESSION_DAYS=30

# Opcional: cria o primeiro cuidador no boot se a tabela estiver vazia.
# BOOTSTRAP_EMAIL=cuidador@example.com
# BOOTSTRAP_PASSWORD=troque-esta-senha
# BOOTSTRAP_NAME=Cuidador

# Opcional: Web Push. Sem as chaves o app sobe e os alarmes push ficam desligados.
# Gere com: npx --yes web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@altamir.dev
# ALARM_SCHEDULER_MS=45000

# Leitura de caixa/receita. Sem AI_API_KEY o site sobe e a captura fica escondida.
# Ligue só depois de revisar a fatia de privacidade.
# AI_ENABLED=1
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL=deepseek/deepseek-v4.1-flash-1017
# AI_PROVIDER_NAME=OpenRouter
# AI_TIMEOUT_MS=45000
# AI_MONTHLY_LIMIT=5
# AI_PRICE_INPUT_PER_MILLION=0.0141
# AI_PRICE_OUTPUT_PER_MILLION=0.144
# AI_HTTP_REFERER=https://medica-certo.altamir.dev
# AI_APP_TITLE=Medica Certo
# AI_DATA_COLLECTION=deny
# AI_IMAGE_RETAIN_DAYS=90
